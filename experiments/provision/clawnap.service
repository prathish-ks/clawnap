# clawnap as a boot service on an experiment host. Install: cp to /etc/systemd/system/, then
#   systemctl daemon-reload && systemctl enable --now clawnap
# Requires /var/lib/clawnap (registry + cells) and /usr/local/bin/clawnap. Swap is the host's
# job: a swapfile in /etc/fstab. -warm-keep-mib 300 trims a paused cell to its working set at once and records
# its hot set; a cold wake prefetches only that (~270 MiB), so -headroom-mib ≈ simultaneous cold wakes × 300 MiB
# (4 GB covers a burst of ten with margin; measured 2026-10-01: 2.8 / 5.2 / 6.8 s at 3.2 GB available).
# Warm cells (300 MiB each, ~1 s wake) are whatever RAM is left above that.
# Swap is the host's (e.g. "/swap.img none swap sw,pri=100 0 0"), no zram.
[Unit]
Description=clawnap daemon (stock OpenClaw cells: hibernate, reclaim, wake on push)
After=docker.service network-online.target
Requires=docker.service

[Service]
Environment=CLAWNAP_DATA=/var/lib/clawnap
EnvironmentFile=-/etc/clawnap.env
ExecStart=/usr/local/bin/clawnap serve -listen 127.0.0.1:8080 -interval 5s -reclaim-after 30m -headroom-mib 4096 -warm-keep-mib 300 -reclaim-keep-mib 150 -prefetch-on-wake -max-pause -1s
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
